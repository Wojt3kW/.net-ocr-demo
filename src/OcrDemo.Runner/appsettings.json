{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "Runner": {
    "InputDirectory": "input_documents",
    "OutputDirectory": "output_documents",
    "EngineFilter": "",
    "FallbackImageDpi": 300,
    "FontPath": "",
    "Warmup": true,
    "SaveRawOutput": true
  },
  "Engines": {
    "OcrMyPdf": {
      "Enabled": true,
      "BaseUrl": "http://localhost:8101",
      "TimeoutSeconds": 3600
    },
    "PaddleOcr": {
      "Enabled": true,
      "BaseUrl": "http://localhost:8102",
      "TimeoutSeconds": 3600
    },
    "Doctr": {
      "Enabled": true,
      "BaseUrl": "http://localhost:8103",
      "TimeoutSeconds": 3600
    },
    "Docling": {
      "Enabled": true,
      "BaseUrl": "http://localhost:8104",
      "TimeoutSeconds": 3600,
      "OcrPresets": [ "rapidocr", "easyocr" ],
      "OcrLanguages": [ "pl", "en" ],
      "TableMode": "accurate"
    }
  }
}
